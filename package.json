{
  "name": "valiant-newton",
  "version": "1.0.0",
  "description": "Autonomous Micro-DaaS Engine with Self-Healing Scraping Pipeline",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "api": "tsx src/index.ts --mode=api",
    "worker": "tsx src/index.ts --mode=worker",
    "cli": "tsx src/cli.ts",
    "scrape": "tsx src/cli.ts scrape",
    "seed": "tsx src/cli.ts seed",
    "test-drift": "tsx src/cli.ts test-drift",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "micro-daas",
    "autonomous-scraping",
    "self-healing",
    "llm",
    "supabase",
    "api-metering"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "csv-stringify": "^6.8.3",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
